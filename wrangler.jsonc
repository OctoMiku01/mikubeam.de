{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikubeam-de",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Before every `wrangler dev` and `wrangler deploy` (also on Cloudflare's automatic builds):
  // download fonts, brand icons and avatar into public/generated/, and rebuild public/banner.jpg.
  "build": {
    "command": "node scripts/assets.mjs && node scripts/banner.mjs"
  },
  // Visitor counter (D1 database created in the Cloudflare dashboard, Western Europe).
  // The table is created by the worker on first use; locally `wrangler dev` uses a local SQLite file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikubeam-de",
      "database_id": "3c0ad40c-3021-4ea3-8650-41f18138e65a"
    }
  ],
  // Files in public/ (avatar, background, favicon, ...) are served directly.
  // Everything else – including "/" – is handled by the worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Custom domain: the zone mikubeam.de must be on Cloudflare; DNS record and certificate are created on deploy.
  "routes": [
    {
      "pattern": "mikubeam.de",
      "custom_domain": true
    }
  ]
}